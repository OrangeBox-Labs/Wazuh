<!--
    OrangeBox - Lightweight Linux/cPanel availability telemetry.

    This decoder consumes command telemetry emitted by Logcollector and
    turns it into dynamic fields for correlation rules. It intentionally
    contains no environment-specific hosts, addresses, or account names.
-->

<decoder name="orangebox_synrecv">
    <parent>ossec</parent>
    <prematch>output: 'orangebox-synrecv':</prematch>
    <regex type="pcre2" offset="after_prematch">\s*ORANGEBOX_SYNRECV count=(\d+) srcip=(\S+) dstip=(\S+) dstport=(\d+)</regex>
    <order>synrecv_count,srcip,dstip,dstport</order>
</decoder>

<decoder name="orangebox_synrecv_total">
    <parent>ossec</parent>
    <prematch>output: 'orangebox-synrecv-total':</prematch>
    <regex type="pcre2" offset="after_prematch">\s*ORANGEBOX_SYNRECV_TOTAL count=(\d+)</regex>
    <order>synrecv_count</order>
</decoder>

<decoder name="orangebox_ksoftirq">
    <parent>ossec</parent>
    <prematch>output: 'orangebox-ksoftirq':</prematch>
    <regex type="pcre2" offset="after_prematch">\s*ORANGEBOX_KSOFTIRQ cpu=(\S+)</regex>
    <order>ksoftirq_cpu</order>
</decoder>

<decoder name="orangebox_load">
    <parent>ossec</parent>
    <prematch>output: 'orangebox-load':</prematch>
    <regex type="pcre2" offset="after_prematch">\s*ORANGEBOX_LOAD cpus=(\d+) load1=(\S+) load5=(\S+) load15=(\S+)</regex>
    <order>cpu_count,load1,load5,load15</order>
</decoder>

<decoder name="orangebox_phpfpm">
    <parent>ossec</parent>
    <prematch>output: 'orangebox-phpfpm':</prematch>
    <regex type="pcre2" offset="after_prematch">\s*ORANGEBOX_PHPFPM user=(\S+) cpu=(\S+) command=(.+)$</regex>
    <order>php_user,php_cpu,php_command</order>
</decoder>
