<!--
    OrangeBox - System Inventory / Syscollector
    Wazuh 4.14.x

    Syscollector base event:
        221 = inventory synchronization event

    This file converts high-value inventory deltas into alerts:
        - network inventory changes
        - new service observed
        - new user observed
        - new UID 0 user observed
        - changes to privileged groups

    We intentionally do not alert on every process or package delta here.
    Those sources are more useful later with higher-confidence conditions.
-->
<group name="orangebox,inventory,syscollector,">

    <!-- Network ports -->
    <rule id="100310" level="3">
        <if_sid>221</if_sid>
        <field name="type">dbsync_ports</field>
        <description>ORANGEBOX: Cambio de inventario de puertos de red.</description>
        <group>inventory,network,</group>
    </rule>

    <!--
        100311 intentionally removed.
        Syscollector INSERTED events can represent transient connections
        or recreation of an existing socket and are not sufficient to
        identify a genuinely new listening port.
    -->

    <!-- Services -->
    <rule id="100312" level="3">
        <if_sid>221</if_sid>
        <field name="type">dbsync_services</field>
        <description>ORANGEBOX: Cambio de inventario de servicios.</description>
        <group>inventory,service,</group>
    </rule>

    <!--
        100313 intentionally removed.
        Syscollector INSERTED events do not reliably mean that a new
        service was created. Systemd template instances such as
        user@UID.service and transient units can legitimately appear
        in the inventory and generate INSERTED events.
    -->

    <!-- Users -->
    <rule id="100314" level="3">
        <if_sid>221</if_sid>
        <field name="type">dbsync_users</field>
        <description>ORANGEBOX: Cambio de inventario de usuarios.</description>
        <group>inventory,identity,</group>
    </rule>

    <rule id="100315" level="12">
        <if_sid>100314</if_sid>
        <field name="operation_type">INSERTED</field>
        <description>ORANGEBOX: Nuevo usuario detectado en el endpoint.</description>
        <group>inventory,identity,account_manipulation,</group>
    </rule>

    <!--
        100320 = NUEVO USUARIO CON PRIVILEGIOS ADMINISTRATIVOS.

        Syscollector puede entregar la pertenencia a grupos privilegiados
        directamente dentro de dbsync_users.user.user_groups cuando se crea
        una cuenta. En ese caso no necesariamente existe un evento
        dbsync_groups/100318 asociado.

        Por ello 100320 es hija de 100315 y detecta la presencia de wheel
        o sudo en la lista de grupos del usuario. Se marca como inmediata
        porque la combinacion "cuenta nueva + grupo privilegiado" tiene
        mayor confianza que un alta de usuario generica.

        El campo puede venir como:
            usuario:wheel
            wheel
            usuario:sudo:otros

        Solo se aceptan coincidencias exactas de los nombres de grupo.
    -->
    <rule id="100320" level="15">
        <if_sid>100315</if_sid>
        <field name="user.user_groups" type="pcre2">(?:^|:)(?:wheel|sudo)(?:$|:)</field>
        <description>ALERTA CRITICA: NUEVO USUARIO CON PRIVILEGIOS ADMINISTRATIVOS (WHEEL/SUDO) DETECTADO EN EL ENDPOINT.</description>
        <group>inventory,identity,account_manipulation,privilege_escalation,privilege_escalation_root,orangebox_immediate,</group>
    </rule>

    <rule id="100316" level="15">
        <if_sid>100315</if_sid>
        <field name="user.user_uid_signed">^0$</field>
        <description>ORANGEBOX: Nuevo usuario con UID 0 detectado en el endpoint.</description>
        <group>inventory,identity,privilege_escalation,privilege_escalation_root,orangebox_immediate,</group>
    </rule>

    <!-- Privileged groups -->
    <rule id="100317" level="3">
        <if_sid>221</if_sid>
        <field name="type">dbsync_groups</field>
        <description>ORANGEBOX: Cambio de inventario de grupos.</description>
        <group>inventory,identity,</group>
    </rule>

    <rule id="100318" level="13">
        <if_sid>100317</if_sid>
        <field name="operation_type">MODIFIED</field>
        <field name="group.group_name" type="pcre2">^(?:wheel|sudo)$</field>
        <description>ORANGEBOX: Grupo privilegiado wheel/sudo modificado.</description>
        <group>inventory,identity,privilege_escalation,orangebox_immediate,</group>
    </rule>

    <rule id="100319" level="13">
        <if_sid>100317</if_sid>
        <field name="operation_type">INSERTED</field>
        <field name="group.group_name" type="pcre2">^(?:wheel|sudo)$</field>
        <description>ORANGEBOX: Grupo privilegiado wheel/sudo creado.</description>
        <group>inventory,identity,privilege_escalation,orangebox_immediate,</group>
    </rule>

</group>
