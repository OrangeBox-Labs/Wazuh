<group name="orangebox,behavior,reconnaissance,">

    <rule id="10615" level="5">
        <if_sid>100318,10001</if_sid>
        <description>ORANGEBOX: EVENTO CANDIDATO PARA CADENA DE CAMBIO DE PRIVILEGIOS Y ACCESO.</description>
        <group>orangebox_privilege_chain_candidate,</group>
    </rule>

    <rule id="10616" level="13" frequency="2" timeframe="600">
        <if_matched_sid>10615</if_matched_sid>
        <same_location/>
        <different_id/>
        <description>ALERTA: CAMBIO DE PRIVILEGIOS SEGUIDO DE LOGIN SSH EN EL ENDPOINT.</description>
        <mitre><id>T1098</id><id>T1021.004</id></mitre>
        <group>privilege_escalation,persistence,attack,orangebox_behavior,orangebox_privilege_chain,</group>
    </rule>

    <rule id="10617" level="5">
        <if_sid>10616,10004,10005</if_sid>
        <description>ORANGEBOX: EVENTO CANDIDATO PARA CADENA DE PRIVILEGIOS.</description>
        <group>orangebox_privilege_chain_root_candidate,orangebox_behavior,</group>
    </rule>

    <rule id="10618" level="15" frequency="2" timeframe="600">
        <if_matched_sid>10617</if_matched_sid>
        <same_location/>
        <different_id/>
        <description>ALERTA CRITICA: CAMBIO DE PRIVILEGIOS, LOGIN SSH Y ELEVACION A ROOT EN LA MISMA CADENA DE ACTIVIDAD.</description>
        <mitre><id>T1098</id><id>T1021.004</id><id>T1068</id></mitre>
        <group>privilege_escalation,attack,orangebox_behavior,orangebox_killchain,</group>
    </rule>

    <rule id="10610" level="14">
        <if_sid>80792</if_sid>
        <list field="audit.command" lookup="match_key_value" check_value="scanner">etc/lists/orangebox-suspicious-programs</list>
        <description>ALERTA CRITICA: HERRAMIENTA DE ESCANEO O RECONOCIMIENTO DE RED EJECUTADA EN EL ENDPOINT: $(audit.command).</description>
        <mitre><id>T1046</id></mitre>
        <group>execution,discovery,network_service_scanning,attack,orangebox_behavior,orangebox_scanner,</group>
    </rule>

    <rule id="10611" level="5">
        <if_sid>80792</if_sid>
        <list field="audit.command" lookup="match_key_value" check_value="recon">etc/lists/orangebox-recon-programs</list>
        <description>ORANGEBOX: COMANDO DE RECONOCIMIENTO DE HOST/RED EJECUTADO: $(audit.command).</description>
        <mitre><id>T1087</id><id>T1016</id><id>T1049</id></mitre>
        <group>discovery,command_execution,orangebox_behavior,orangebox_recon,</group>
    </rule>

    <rule id="10612" level="14" frequency="3" timeframe="300">
        <if_matched_sid>10611</if_matched_sid>
        <same_location/>
        <different_field>audit.command</different_field>
        <description>ALERTA: POSIBLE RECONOCIMIENTO DE RED DESDE ENDPOINT. SE DETECTARON MULTIPLES COMANDOS DE ENUMERACION EN 5 MINUTOS.</description>
        <mitre><id>T1046</id><id>T1016</id></mitre>
        <group>discovery,network_service_scanning,attack,orangebox_behavior,orangebox_recon,</group>
    </rule>

    <rule id="10613" level="15" frequency="2" timeframe="600">
        <if_sid>10005</if_sid>
        <if_matched_group>orangebox_recon</if_matched_group>
        <same_location/>
        <description>ALERTA CRITICA: ELEVACION A ROOT DESPUES DE ACTIVIDAD DE RECONOCIMIENTO.</description>
        <mitre><id>T1068</id><id>T1046</id></mitre>
        <group>privilege_escalation,discovery,attack,orangebox_behavior,orangebox_killchain,</group>
    </rule>

    <rule id="10614" level="15" frequency="3" timeframe="600">
        <if_matched_group>orangebox_behavior</if_matched_group>
        <same_location/>
        <description>ALERTA CRITICA: CADENA DE ACTIVIDAD SOSPECHOSA DETECTADA. MULTIPLES ETAPAS DE COMPORTAMIENTO EN UN MISMO ENDPOINT.</description>
        <mitre><id>T1046</id><id>T1059</id><id>T1068</id><id>T1021.004</id><id>T1053</id></mitre>
        <group>attack,orangebox_behavior,orangebox_killchain,</group>
    </rule>

</group>
