<group name="orangebox,behavior,reconnaissance,">

    <!--
        10615-10618 removed from the base ruleset.

        These rules were implemented as children of authentication events
        (10001/10004/10005). In Wazuh, a child rule matching the same event
        can become the final fired rule, replacing the base alert that the
        OrangeBox mail integration uses for SSH/SU/SUDO handling.

        In particular:
            10001 (SSH successful) -> 10615
        caused the SSH alert to arrive at the integration as 10615 instead
        of 10001, breaking the locked daily SSH notification path.

        The privilege-chain correlation must therefore be implemented with
        a mechanism that preserves the original authentication rule IDs.
        Do not reintroduce 10615-10618 as direct children of 10001, 10004
        or 10005 without regression testing of the alert IDs delivered to
        the integration.
    -->

    <rule id="10610" level="14">
        <if_sid>80792</if_sid>
        <list field="audit.command" lookup="match_key_value" check_value="scanner">etc/lists/orangebox-suspicious-programs</list>
        <description>ALERTA CRITICA: HERRAMIENTA DE ESCANEO O RECONOCIMIENTO DE RED EJECUTADA EN EL ENDPOINT: $(audit.command).</description>
        <mitre><id>T1046</id></mitre>
        <group>execution,discovery,network_service_scanning,attack,orangebox_behavior,orangebox_scanner,orangebox_immediate,</group>
    </rule>

    <rule id="10611" level="5">
        <if_sid>80792</if_sid>
        <list field="audit.command" lookup="match_key_value" check_value="recon">etc/lists/orangebox-recon-programs</list>
        <description>ORANGEBOX: COMANDO DE RECONOCIMIENTO DE HOST/RED EJECUTADO: $(audit.command).</description>
        <mitre><id>T1087</id><id>T1016</id><id>T1049</id></mitre>
        <group>discovery,command_execution,orangebox_behavior,orangebox_recon,</group>
    </rule>

    <rule id="10612" level="14" frequency="3" timeframe="300">
        <if_matched_sid>10611</if_matched_sid>
        <same_location/>
        <different_field>audit.command</different_field>
        <description>ALERTA: POSIBLE RECONOCIMIENTO DE RED DESDE ENDPOINT. SE DETECTARON MULTIPLES COMANDOS DE ENUMERACION EN 5 MINUTOS.</description>
        <mitre><id>T1046</id><id>T1016</id></mitre>
        <group>discovery,network_service_scanning,attack,orangebox_behavior,orangebox_recon,</group>
    </rule>

    <!--
        El evento actual debe ser 10005 (sudo -> root) y se requiere
        al menos DOS coincidencias previas de 10611 dentro de
        los 10 minutos; el evento actual debe ser 10005.
    -->
    <rule id="10613" level="15" frequency="2" timeframe="600">
        <if_sid>10005</if_sid>
        <if_matched_sid>10611</if_matched_sid>
        <description>ALERTA CRITICA: ELEVACION A ROOT DESPUES DE ACTIVIDAD DE RECONOCIMIENTO.</description>
        <mitre><id>T1068</id><id>T1046</id></mitre>
        <group>privilege_escalation,discovery,attack,orangebox_behavior,orangebox_killchain,orangebox_immediate,</group>
    </rule>

    <rule id="10614" level="15" frequency="3" timeframe="600">
        <if_matched_group>orangebox_behavior</if_matched_group>
        <same_location/>
        <description>ALERTA CRITICA: CADENA DE ACTIVIDAD SOSPECHOSA DETECTADA. MULTIPLES ETAPAS DE COMPORTAMIENTO EN UN MISMO ENDPOINT.</description>
        <mitre><id>T1046</id><id>T1059</id><id>T1068</id><id>T1021.004</id><id>T1053</id></mitre>
        <group>attack,orangebox_behavior,orangebox_killchain,orangebox_immediate,</group>
    </rule>


    <!--
        20055 - EXCEPCION: chequeo interno de Zimbra contra zmconfigd.

        Zimbra utiliza "nc -w 15 localhost 7171" para comprobar el servicio
        zmconfigd. No se excluye "nc" de forma global: solamente se silencia
        este comando exacto dentro de un agente perteneciente al grupo
        Wazuh "zimbra".

        La coincidencia se hace sobre el evento auditd bruto para exigir:
          - AUID/UID/GID = zimbra
          - /usr/bin/nc
          - -w 15
          - localhost
          - puerto 7171
          - CWD /opt/zimbra

        Cualquier otra ejecucion de nc mantiene la alerta 10610.
    -->
    <rule id="20055" level="0">
        <if_sid>10610</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^zimbra$">etc/lists/orangebox-zimbra-agents</list>
        <match type="pcre2">(?s)AUID="zimbra".*?UID="zimbra".*?GID="zimbra".*?type=EXECVE.*?argc=5\s+a0="/usr/bin/nc"\s+a1="-w"\s+a2="15"\s+a3="localhost"\s+a4="7171".*?type=CWD.*?cwd="/opt/zimbra"</match>
        <description>EXCEPCION: Chequeo interno de Zimbra a zmconfigd mediante nc localhost:7171.</description>
        <group>orangebox,behavior,whitelist,zimbra,orangebox_exception,</group>
    </rule>

</group>
