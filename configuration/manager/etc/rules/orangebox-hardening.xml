        <group>orangebox_exception,orangebox_review,dpkg,cron,</group>
    </rule>
</group>


<!--
    Mantenimiento automatico de cPanel en agentes identificados por el perfil
    funcional CDB "cpanel".

    Los eventos se conservan en nivel 3 para mantener trazabilidad en Wazuh,
    pero dejan de generar correo critico. Las excepciones se limitan a los
    procesos/rutas observados y no alteran las reglas de deteccion generales.
-->
<group name="orangebox,hardening,fim,whitelist,cpanel,maintenance,">

    <!--
        cPanel ejecuta scripts/fixetchosts durante el mantenimiento.
        Who-Data identifica el interprete Perl empaquetado por cPanel;
        /etc/hosts es la unica ruta exceptuada.
    -->
    <rule id="20072" level="3">
        <if_sid>10036</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file">^/etc/hosts$</field>
        <field name="process_name" type="pcre2">^/usr/local/cpanel/3rdparty/perl/[0-9]+/bin/perl$</field>
        <field name="user_name">^root$</field>
        <field name="effective_uid">^0$</field>
        <description>EXCEPCION OPERACIONAL: cPanel fixetchosts actualiza /etc/hosts durante mantenimiento programado.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,maintenance,network,dns,</group>
    </rule>

    <!-- Regeneracion del cron de analiticas de cPanel por su Perl empaquetado. -->
