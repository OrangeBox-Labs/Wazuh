         20072 = mantenimiento de /etc/hosts por cPanel fixetchosts (perfil cpanel; nivel 3)
         20073 = regeneracion de cpanel-analytics por Perl de cPanel (perfil cpanel; nivel 3)
         20074 = limpieza de cpanel-analytics y su lock (perfil cpanel; nivel 3)
         20075 = eliminacion del cron Imunify360 durante mantenimiento (perfil cpanel; nivel 3)
         20076 = limpieza de unidades SocialBee/XOVI por cPanel (perfil cpanel; nivel 3)
         20077 = reconstruccion temporal de csf.allow por Imunify360 (perfil cpanel, marcadores csf_tool, nivel 3)
         20062 = reescritura GCP exacta de /etc/hosts por sed/root (nivel 3)
         20064 = rearme Who-Data de /etc/hosts atribuido a syscheckd/root (nivel 5)
         20080 = /etc/hosts reescrito por proceso root sin cambios de contenido (nivel 3)
         20082 = FIM scheduled/realtime con diff GCP completo y exacto (nivel 3)
     IMPORTANTE SOBRE FIM:
         Las reglas de modificacion 10030-10037, 10046 y 10048 solo generan
         alerta cuando Wazuh reporta evidencia de cambio de contenido en
         changed_fields (size/md5/sha1/sha256).

     Cuando sea necesario agregar una nueva excepcion, debe utilizar un ID
     entre 20000 y 29999 y referenciar explicitamente la regla OrangeBox
     correspondiente mediante <if_sid>.

     IMPORTANTE:
         - No agregar excepciones sin validar previamente el cambio.
         - Las excepciones deben ser lo mas especificas posible.
         - Esta seccion debe permanecer despues de TODAS las reglas de deteccion.
         - Una excepcion por no-cambio de contenido NO cubre cambios reales
           de contenido: si el archivo cambia su contenido, 10037 sigue
           generando la alerta.
     ================================================================= -->

<group name="orangebox,hardening,fim,whitelist,">
    <!--
        cPanel mantiene y regenera este cron automaticamente durante
        las tareas de renovacion/reemision SSL.
        La modificacion del contenido es esperada y no representa una
        alteracion de persistencia maliciosa.
    -->
    <rule id="20032" level="0">
        <!--
            cPanel mantiene y regenera este cron durante tareas normales de
            renovacion o reemision SSL.

            La excepcion requiere dos condiciones:
              1) el evento pertenece al perfil funcional "cpanel";
              2) el archivo afectado es exactamente cpanel_ssl_reissue.

            De esta forma una ruta con el mismo nombre en otro tipo de
            servidor no queda globalmente autorizada.
        -->
        <if_sid>10035</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file" type="pcre2">^/etc/cron\.d/cpanel_ssl_reissue$</field>
        <description>EXCEPCION: Cron cPanel cpanel_ssl_reissue regenerado automaticamente.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,cron,</group>
    </rule>
</group>


<!--
     EXCEPCIONES cPanel - CAMBIOS OPERACIONALES ESPERADOS

     cPanel modifica /etc/passwd, /etc/shadow, /etc/group y /etc/gshadow
     al crear o actualizar cuentas. CSF/LFD modifica /etc/csf/csf.deny al
     bloquear automaticamente una IP despues de intentos fallidos.
     cPanel/Imunify puede regenerar /etc/sysconfig/nftables.conf; en los
     eventos validados de este entorno el cambio corresponde a counters.

     Estas excepciones estan condicionadas al perfil funcional cpanel y
     solamente afectan las rutas concretas observadas. No se desactiva
     10030/10037 para el resto de servidores ni para otras rutas.
-->
<group name="orangebox,hardening,fim,whitelist,cpanel,">
    <!-- Regla 20050: Silencia cambios rutinarios de archivos de identidad realizados por operaciones normales de cPanel. -->
    <rule id="20050" level="0">
        <if_sid>10030</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file" type="pcre2">^/etc/passwd$|^/etc/shadow$|^/etc/group$|^/etc/gshadow$</field>
        <description>EXCEPCION: cPanel modifica archivos de cuentas durante operaciones normales.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,identity,</group>
    </rule>

    <!-- Regla 20051: Silencia actualizaciones de csf.deny generadas por CSF/LFD en agentes cPanel. -->

    <rule id="20051" level="0">
        <if_sid>10037</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file">^/etc/csf/csf\.deny$</field>
        <description>EXCEPCION: CSF/LFD actualiza csf.deny como parte de su operacion normal.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,firewall,</group>
    </rule>

    <!-- Regla 20052: Silencia la regeneración operacional de nftables.conf por cPanel/Imunify en agentes cPanel. -->

    <rule id="20052" level="0">
        <if_sid>10037</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file">^/etc/sysconfig/nftables\.conf$</field>
        <description>EXCEPCION: cPanel/Imunify regenera nftables.conf con cambios operacionales de counters.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,firewall,</group>
    </rule>
</group>


<!--
    DNSOnly / plugins de cPanel no utilizados por el servicio DNS.
    Solo se exceptuan las cuatro unidades concretas observadas y solo
    en agentes incluidos en el grupo Wazuh "DNS".
-->
<group name="orangebox,hardening,fim,whitelist,dns,">
    <!-- Regla 20057: Silencia la eliminación de unidades SocialBee/XOVI no utilizadas, solo en agentes DNSOnly autorizados. -->
    <rule id="20057" level="0">
        <if_sid>10044</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^DNS$">etc/lists/orangebox-dns-agents</list>
        <field name="file" type="pcre2">^/etc/systemd/system/initialize_(?:socialbee|xovi)_plugin\.(?:service|timer)(?:;[0-9A-Fa-f]{8})?$</field>
        <description>EXCEPCION: Limpieza de plugins SocialBee/XOVI no utilizados en DNSOnly.</description>
        <group>orangebox_exception,orangebox_whitelist,dns,systemd,</group>
    </rule>
</group>

