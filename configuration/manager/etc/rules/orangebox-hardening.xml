        <field name="file">^/etc/cron\.d/imunify360-purge-clamav$</field>
        <field name="process_name">^/usr/bin/rm$</field>
        <field name="user_name">^root$</field>
        <field name="effective_uid">^0$</field>
        <description>EXCEPCION OPERACIONAL: Imunify360 retira su cron purge-clamav durante mantenimiento de paquetes.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,imunify360,maintenance,cron,</group>
    </rule>

    <!--
        cPanel limpia unidades SocialBee/XOVI y enlaces de activacion
