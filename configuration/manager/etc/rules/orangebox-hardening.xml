        <field name="mode">whodata</field>
        <field name="file" type="pcre2">^/etc/systemd/system/(?:initialize_(?:socialbee|xovi)_plugin\.(?:service|timer)|timers\.target\.wants/initialize_(?:socialbee|xovi)_plugin\.timer)$</field>
        <field name="parent_name" type="pcre2">^/usr/local/cpanel/3rdparty/perl/[0-9]+/bin/perl$</field>
        <field name="user_name">^root$</field>
        <field name="effective_uid">^0$</field>
        <description>EXCEPCION OPERACIONAL: cPanel limpia unidades o enlaces de activacion SocialBee/XOVI durante mantenimiento de plugins.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,maintenance,systemd,</group>
    </rule>

</group>

<!--
    Imunify360 reconstruye la lista de allow de CSF en un archivo temporal
    /etc/csf/csf.allow.<suffix>, elimina/actualiza las IP de sus servidores
    y luego el flujo de shell publica el resultado. Los eventos observados
    en el temporal fueron ejecutados por cp/chown/sed bajo bash y sus diffs
    contienen los marcadores csf_tool de Imunify360.
    
    Se conserva nivel 3 para auditoria. La excepcion NO cubre el archivo
    final /etc/csf/csf.allow, csf.pignore, csf.deny ni otras configuraciones
    CSF: sus cambios siguen siendo alertados por 10037.
-->
<group name="orangebox,hardening,fim,whitelist,cpanel,imunify360,firewall,">
    <rule id="20077" level="3">
        <if_sid>10037</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="mode">whodata</field>
        <field name="file" type="pcre2">^/etc/csf/csf\.allow\.[A-Za-z0-9_-]+$</field>
        <field name="process_name" type="pcre2">^/usr/bin/(?:cp|chown|sed)$</field>
        <field name="parent_name">^/usr/bin/bash$</field>
        <field name="user_name">^root$</field>
        <field name="effective_uid">^0$</field>
        <field name="changed_content" type="pcre2">(?s)(?:csf_tool: imunify360 server|csf_tool: files\.imunify360\.com server|Include /var/imunify360/files/whitelist/v2/imunify360\.txt)</field>
        <description>EXCEPCION OPERACIONAL: Imunify360 reconstruye su lista temporal csf.allow mediante csf_tool.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,imunify360,firewall,</group>
    </rule>
</group>

