        <if_sid>10035</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file" type="pcre2">^/etc/cron\.d/cpanel-analytics(?:\.lock)?$</field>
        <field name="process_name" type="pcre2">^/usr/local/cpanel/3rdparty/perl/[0-9]+/bin/perl$</field>
        <field name="user_name">^root$</field>
        <field name="effective_uid">^0$</field>
        <description>EXCEPCION OPERACIONAL: cPanel regenera su cron de analiticas o archivo lock durante mantenimiento.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,maintenance,cron,</group>
    </rule>

    <!-- Eliminacion del cron de analiticas/lock durante limpieza de cPanel. -->
    <rule id="20074" level="3">
        <if_sid>10045</if_sid>
        <list field="hostname" lookup="match_key_value" check_value="^cpanel$">etc/lists/orangebox-cpanel-agents</list>
        <field name="file" type="pcre2">^/etc/cron\.d/cpanel-analytics(?:\.lock)?$</field>
        <field name="user_name">^root$</field>
        <field name="effective_uid">^0$</field>
        <description>EXCEPCION OPERACIONAL: cPanel elimina su cron de analiticas o archivo lock durante mantenimiento.</description>
        <group>orangebox_exception,orangebox_whitelist,cpanel,maintenance,cron,</group>
    </rule>

    <!-- Imunify360 retira su cron de limpieza durante una actualizacion. -->
    <rule id="20075" level="3">
        <if_sid>10045</if_sid>
