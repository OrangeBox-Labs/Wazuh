<!--
    ORANGEBOX - Deteccion derivada del incidente host.example.invalid
    ================================================================

    Cobertura agregada a partir del RCA del 2026-10-23:
      - barridos .env/.git/credentials/cloud JSON
      - exposicion accidental de secretos con HTTP 2xx
      - correlacion de reconocimiento web por IP
      - loop interno Serf/mod_pagespeed
      - bypass de cache ?k=xxxxx&page=...
      - indicadores de spam SEO servido con HTTP 200
      - SYN-RECV persistente y presion distribuida
      - ksoftirqd elevado
      - load por encima de la capacidad CPU
      - pools PHP-FPM calientes

    Las respuestas automaticas se limitan a origenes remotos y a señales
    de reconocimiento de alta confianza. No se bloquean IPs locales ni
    proxies autorizados.
-->

<!-- ================================================================
     WEB RECON / CREDENTIAL DISCOVERY
================================================================ -->
<group name="orangebox,">

    <!-- Cualquier respuesta HTTP a una ruta de alto interes. Nivel 1 de contexto. -->
    <rule id="10820" level="4">
        <url type="pcre2">(?i)^/(?:\.git(?:/|$)|\.env(?:[._/-]|$)|\.config/gcloud(?:/|$)|\.aws(?:/|$)|credentials\.json(?:$|[?])|firebase-adminsdk[^/]*\.json(?:$|[?])|\.docker/config\.json(?:$|[?])|\.npmrc(?:$|[?])|wp-config\.php(?:[._/-]|$)|composer\.(?:json|lock)(?:$|[?])|config\.(?:json|yaml|yml|php)(?:[._-]|$)|database\.(?:sql|sqlite)(?:$|[?]))</url>
        <description>ORANGEBOX: Sondeo de ruta web sensible o potencialmente portadora de credenciales.</description>
        <mitre>
            <id>T1083</id>
            <id>T1552</id>
        </mitre>
        <group>orangebox,web,reconnaissance,credential_discovery,attack,orangebox_web_sensitive_probe,</group>
    </rule>

    <!-- Un archivo de credenciales devolviendo 2xx es una señal de exposicion. -->
    <rule id="10821" level="13">
        <if_sid>10820</if_sid>
        <status type="pcre2">^2\d\d$</status>
        <url type="pcre2">(?i)^/(?:\.env(?:[._/-]|$)|credentials\.json(?:$|[?])|firebase-adminsdk[^/]*\.json(?:$|[?])|\.config/gcloud(?:/|$)|\.aws/(?:credentials|config)(?:$|[?])|\.docker/config\.json(?:$|[?])|\.npmrc(?:$|[?])|wp-config\.php(?:[._/-]|$))</url>
        <list field="srcip" lookup="not_address_match_key">etc/lists/orangebox-web-discovery-proxies</list>
        <description>ALERTA CRITICA: Posible exposicion exitosa de archivo de credenciales/secretos web con HTTP 2xx desde $(srcip).</description>
        <mitre>
            <id>T1552.001</id>
        </mitre>
        <group>orangebox,web,reconnaissance,credential_discovery,attack,credential_access,exposure,orangebox_web_auto_block,</group>
    </rule>

    <!-- Tres rutas sensibles distintas en 60 s: scanner activo. -->
    <rule id="10822" level="14" frequency="3" timeframe="60" ignore="300">
        <if_matched_sid>10820</if_matched_sid>
        <same_srcip />
        <different_url />
        <list field="srcip" lookup="not_address_match_key">etc/lists/orangebox-web-discovery-proxies</list>
        <description>ALERTA CRITICA: Reconocimiento automatizado de multiples archivos sensibles desde la misma IP $(srcip).</description>
        <mitre>
            <id>T1595.002</id>
            <id>T1552.001</id>
        </mitre>
        <group>orangebox,web,reconnaissance,credential_discovery,attack,orangebox_web_auto_block,</group>
    </rule>

    <!-- Repeticion de una misma ruta sensible: tambien merece contencion. -->
    <rule id="10823" level="13" frequency="3" timeframe="30" ignore="300">
        <if_matched_sid>10820</if_matched_sid>
        <same_srcip />
        <same_url />
        <list field="srcip" lookup="not_address_match_key">etc/lists/orangebox-web-discovery-proxies</list>
        <description>ALERTA: Repeticion automatizada de acceso a recurso web sensible desde $(srcip).</description>
        <mitre>
            <id>T1595.002</id>
        </mitre>
        <group>orangebox,web,reconnaissance,credential_discovery,attack,orangebox_web_auto_block,</group>
    </rule>


<!-- ================================================================
     MOD_PAGESPEED / LOOPS INTERNOS
================================================================ -->

    <rule id="10824" level="5">
        <regex type="pcre2">(?i)Serf/1\.3\.9.*mod_pagespeed/1\.13\.35\.2|mod_pagespeed/1\.13\.35\.2.*Serf/1\.3\.9</regex>
        <description>ORANGEBOX: Solicitud HTTP asociada al User-Agent interno Serf/mod_pagespeed observado durante el incidente.</description>
        <group>orangebox,web,availability,mod_pagespeed,orangebox_web_internal_loop,</group>
    </rule>

    <!-- Regla 10825: Detecta un bucle de solicitudes HTTP internas repetidas asociado a mod_pagespeed. -->

    <rule id="10825" level="12" frequency="20" timeframe="30" ignore="120">
        <if_matched_sid>10824</if_matched_sid>
        <same_srcip />
        <description>ALERTA: Posible bucle/autopeticion HTTP interna de mod_pagespeed; alta repeticion desde $(srcip).</description>
        <mitre>
            <id>T1499.002</id>
        </mitre>
        <group>orangebox,web,availability,mod_pagespeed,denial_of_service,orangebox_web_internal_loop,</group>
    </rule>


<!-- ================================================================
     BOT / CACHE BYPASS / SEO SPAM
================================================================ -->

    <rule id="10826" level="4">
        <url type="pcre2">(?i)(?:[?&amp;]k=[A-Za-z0-9]{5}(?:&amp;|$)|[?&amp;]page=\d+)</url>
        <regex type="pcre2">(?i)Claude-SearchBot/1\.0|SemrushBot/7|SemrushBot</regex>
        <description>ORANGEBOX: Bot/crawler con patron de evasión de cache observado en el incidente.</description>
        <group>orangebox,web,bot_abuse,availability,orangebox_web_bot_abuse,</group>
    </rule>

    <!-- Regla 10827: Detecta ráfagas repetitivas de bots con parámetros de evasión de caché que pueden degradar PHP-FPM o MariaDB. -->

    <rule id="10827" level="10" frequency="20" timeframe="60" ignore="120">
        <if_matched_sid>10826</if_matched_sid>
        <same_srcip />
        <same_url />
        <description>ALERTA: Rafaga repetitiva de bot con parametros de evasión de cache; revisar impacto sobre PHP-FPM/MariaDB.</description>
        <mitre>
            <id>T1499.002</id>
        </mitre>
        <group>orangebox,web,bot_abuse,availability,resource_exhaustion,</group>
    </rule>

    <!-- IOC concreto del incidente: spam SEO servido como HTTP 200. -->
    <rule id="10828" level="12">
        <status>200</status>
        <url type="pcre2">(?i)(?:gg[-_]?bet|zaklady[-_]?esportowe|casino|sportsbook|betting)</url>
        <description>ALERTA: URL con patrón de spam SEO/apuestas servida con HTTP 200; posible compromiso de contenido.</description>
        <mitre>
            <id>T1565.001</id>
        </mitre>
        <group>orangebox,web,bot_abuse,availability,compromise,seo_spam,content_injection,orangebox_web_compromise,</group>
    </rule>


<!-- ================================================================
     HOST AVAILABILITY TELEMETRY
================================================================ -->

    <!--
        Regla base silenciosa para contabilizar muestras SYN-RECV calificadas.
        Debe ser level 1 (level 0 se descarta y no sirve para if_matched_sid).
    -->
    <rule id="10835" level="1">
        <decoded_as>orangebox_synrecv</decoded_as>
        <field name="synrecv_count" type="pcre2">^(?:[2-9]\d|[1-9]\d{2,})$</field>
        <options>no_log</options>
        <description>ORANGEBOX: Muestra de telemetría SYN-RECV sobre el umbral.</description>
        <group>orangebox,availability,host,synrecv_telemetry,</group>
    </rule>

    <!-- Persistencia de SYN-RECV por una misma fuente/servicio. -->
    <rule id="10829" level="13" frequency="3" timeframe="180" ignore="120">
        <if_matched_sid>10835</if_matched_sid>
        <decoded_as>orangebox_synrecv</decoded_as>
        <field name="synrecv_count" type="pcre2">^(?:[2-9]\d|[1-9]\d{2,})$</field>
        <same_srcip />
        <same_dstip />
        <same_dstport />
        <description>ALERTA CRITICA: Presion TCP persistente; $(synrecv_count) conexiones SYN-RECV de $(srcip) hacia $(dstip):$(dstport).</description>
        <mitre>
            <id>T1499.001</id>
        </mitre>
        <group>orangebox,availability,host,firewall,flood,denial_of_service,orangebox_syn_flood_block,</group>
    </rule>

    <!-- Saturacion de la tabla SYN-RECV aunque el ataque sea distribuido. -->
    <rule id="10830" level="12" ignore="300">
        <decoded_as>orangebox_synrecv_total</decoded_as>
        <field name="synrecv_count" type="pcre2">^(?:[5-9]\d|[1-9]\d{2,})$</field>
        <description>ALERTA: Presion elevada de conexiones TCP SYN-RECV en el endpoint; el estado de sockets alcanza 50 o mas.</description>
        <mitre>
            <id>T1499.001</id>
        </mitre>
        <group>orangebox,availability,host,firewall,flood,denial_of_service,orangebox_syn_state,</group>
    </rule>

    <!-- ksoftirqd: señal de impacto del flood en el subsistema de red/kernel. -->
    <rule id="10831" level="12" ignore="300">
        <decoded_as>orangebox_ksoftirq</decoded_as>
        <description>ALERTA: Consumo agregado de ksoftirqd superior al 20% equivalente a un nucleo en una muestra de aproximadamente 1 s; correlacionar con trafico, softirq y CPU general.</description>
        <mitre>
            <id>T1499</id>
        </mitre>
        <group>orangebox,availability,host,kernel,network,flood,</group>
    </rule>

    <!--
        Regla base silenciosa para contabilizar muestras de load.
        El comando del agente solo emite esta métrica cuando load1 supera el
        número de CPU, por lo que cada evento ya representa una muestra alta.
    -->
    <rule id="10836" level="1">
        <decoded_as>orangebox_load</decoded_as>
        <options>no_log</options>
        <description>ORANGEBOX: Muestra de load superior al número de CPU.</description>
        <group>orangebox,availability,host,load_telemetry,</group>
    </rule>

    <!-- Load por encima de la capacidad de CPU durante una ventana persistente. -->
    <rule id="10832" level="8" frequency="3" timeframe="900" ignore="900">
        <if_matched_sid>10836</if_matched_sid>
        <decoded_as>orangebox_load</decoded_as>
        <description>ALERTA: Load Average por encima de la cantidad de CPU durante una ventana persistente; revisar CPU, IO, red y procesos.</description>
        <group>orangebox,availability,host,performance,load,</group>
    </rule>

    <!-- Pool PHP-FPM con workers calientes; se correlaciona por cuenta. -->
    <rule id="10833" level="8">
        <decoded_as>orangebox_phpfpm</decoded_as>
        <field name="php_cpu" type="pcre2">^(?:2[5-9]|[3-9]\d|\d{3,})(?:\.\d+)?$</field>
        <description>ORANGEBOX: Worker PHP-FPM de $(php_user) consumio $(php_cpu)% de un nucleo en una muestra de aproximadamente 1 s; comando $(php_command).</description>
        <group>orangebox,availability,host,php_fpm,resource_exhaustion,</group>
    </rule>

    <!-- Regla 10834: Detecta consumo elevado sostenido en un pool PHP-FPM y alerta sobre el usuario afectado. -->

    <rule id="10834" level="12" frequency="3" timeframe="180" ignore="300">
        <if_matched_sid>10833</if_matched_sid>
        <same_field>php_user</same_field>
        <description>ALERTA: Pool PHP-FPM de $(php_user) mantiene consumo elevado; posible abuso HTTP, bot o aplicacion degradada.</description>
        <mitre>
            <id>T1499.002</id>
        </mitre>
        <group>orangebox,availability,host,php_fpm,resource_exhaustion,orangebox_phpfpm_pressure,</group>
    </rule>

</group>
