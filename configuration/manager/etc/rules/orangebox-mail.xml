<!--
    OrangeBox Wazuh - Deteccion de autenticacion de correo

    Usa reglas nativas de Wazuh como fuente y agrega una capa OrangeBox
    para resaltar intentos repetidos de autenticacion contra servicios
    de correo.

    Las detecciones 10700/10701 ejecutan firewall-drop durante 24 horas.
    La integracion de correo suprime el envio individual porque es un evento
    recurrente; la alerta permanece registrada en Wazuh.
-->

<group name="orangebox,mail,email,authentication,">

    <!-- Postfix: Wazuh nativo 3357 ya correlaciona multiples fallos SASL. -->
    <rule id="10700" level="13">
        <if_sid>3357</if_sid>
        <description>ALERTA: POSIBLE FUERZA BRUTA CONTRA AUTENTICACION SMTP.</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>authentication_failed,brute_force,mail,attack,orangebox_mail,</group>
    </rule>

    <!-- Exim/Dovecot: Wazuh nativo 87507 ya correlaciona multiples fallos. -->
    <rule id="10701" level="13">
        <if_sid>87507</if_sid>
        <description>ALERTA: POSIBLE FUERZA BRUTA CONTRA AUTENTICACION EXIM/DOVECOT.</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>authentication_failed,brute_force,mail,attack,orangebox_mail,</group>
    </rule>

</group>


<!--
    Regla nativa 40106 busca una secuencia de arrobas y la describe como
    posible desbordamiento de yppasswd. SpamAssassin también puede registrar
    secuencias de ese tipo cuando falla la conversión de un nombre IDN.
    Se baja únicamente ese caso a nivel 5: el evento permanece en alerts.json
    para revisar el correo y no se clasifica como desbordamiento confirmado.
-->
<group name="orangebox,mail,spam,">
    <rule id="20056" level="5">
        <if_sid>40106</if_sid>
        <program_name>spamd</program_name>
        <match type="pcre2">util:\s*idn_to_ascii:\s*conversion to ACE failed:.*@{25,}</match>
        <description>ANOMALIA: SpamAssassin encontro un nombre IDN malformado con una secuencia extensa de arrobas; revisar el correo.</description>
        <group>mail,spam,orangebox_mail,orangebox_review,</group>
    </rule>
</group>
